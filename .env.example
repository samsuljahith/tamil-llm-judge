# Copy this file to .env and fill in your keys. .env is git-ignored: never commit real keys.
#
# Step 03 judge slate (four judges, all at temperature 0, snapshot IDs pinned in the JSONL log):
#   FRONTIER   a current frontier model (NOT GPT-4o: it is a 2024 model and also appears
#              inside the PARIKSHA responses). Run via OpenRouter, or a direct provider key.
#   LOW_COST   the cheap tier from the SAME provider as FRONTIER (e.g. frontier GPT-5 -> GPT-5-mini).
#   SEA_LION   the instruct variant exposed by your SEA-LION trial key (confirm with
#              `GET https://api.sea-lion.ai/v1/models`). Record its exact model ID.
#   BASE_MODEL the exact instruct model the chosen SEA-LION variant was built from, via OpenRouter
#              (e.g. Gemma-SEA-LION-v4-27B-IT -> google/gemma-3-27b-it;
#                    Qwen-SEA-LION-v4-32B-IT  -> qwen/qwen3-32b).
#              This is the regional-tuning control (novelty #2): same base, with vs without SEA tuning.

# One OpenRouter key covers FRONTIER, LOW_COST and BASE_MODEL (~US$20-30 prepaid is plenty).
OPENROUTER_API_KEY=

# SEA-LION API (AI Singapore). Free but rate-limited to 10 requests/min/user, so it is the slowest
# judge (~6,300 Tamil calls ~= 10.5 h minimum). Key: https://playground.sea-lion.ai/key-manager
# OpenAI-compatible endpoint, base_url = https://api.sea-lion.ai/v1
SEA_LION_API_KEY=

# Optional: direct provider keys, only if you already pay for them (otherwise leave blank and use
# OpenRouter above). If set, step 03 prefers the direct key for that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
